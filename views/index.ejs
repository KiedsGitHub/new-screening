<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="index" appConnect="local" components="{dmxBootstrap5Navigation:{},dmxNotifications:{},dmxBrowser:{}}" -->
<div is="dmx-browser" id="browser1"></div>
<dmx-notifications id="notifies1"></dmx-notifications>

<meta name="ac:route" content="/" />

<div class="container-fluid vh-100 d-flex justify-content-center align-items-center bg-light">
    <!-- Login Form Section -->
    <div class="col-lg-4 p-4 rounded shadow-sm bg-white">
        <h2 class="text-center mb-4 text-primary">HR Portal</h2>
        <form id="loginIndex" is="dmx-serverconnect-form" method="post" action="/api/action/loginUser" dmx-on:unauthorized="notifies1.warning('Unauthorized!')" dmx-on:success="browser1.goto('/menu',true,'Menu')">
            <!-- Email Field with Icon -->
            <div class="form-group mb-3">
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                    <input type="email" id="email" name="email" class="form-control" placeholder="Email" required>
                </div>
            </div>

            <!-- Password Field with Icon -->
            <div class="form-group mb-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                    <input type="password" id="password" name="password" class="form-control" placeholder="Password" required>
                </div>
            </div>

            <!-- Login Button -->
            <button type="submit" class="btn btn-primary w-100 py-2">Login</button>
        </form>

        <!-- Link to Signup Modal -->
        <p class="text-center text-muted mt-3">No account? <a href="#" data-bs-toggle="modal" data-bs-target="#registerModal">Sign Up</a></p>
    </div>

    <!-- Register Modal (Simplified) -->
    <div class="modal fade" id="registerModal" tabindex="-1" aria-labelledby="registerModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body p-4">
                    <h4 class="text-center mb-4">Create Account</h4>
                    <form action="/api/action/registerUser" method="post" dmx-on:success="notifies1.success('Register completed! Please login.');registerIndex.reset()" is="dmx-serverconnect-form" id="registerIndex">
                        <!-- Name -->
                        <div class="form-group mb-3">
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                                <input type="text" id="name" name="name" class="form-control" placeholder="Name" required>
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="form-group mb-3">
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input type="email" id="emails" name="email" class="form-control" placeholder="Email" required>
                            </div>
                        </div>

                        <!-- Password -->
                        <div class="form-group mb-4">
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                <input type="password" id="password1" name="password" class="form-control" placeholder="Password" required>
                            </div>
                        </div>

                        <!-- Confirm Password -->
                        <div class="form-group mb-4">
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                <input type="password" id="password2" class="form-control" placeholder="Confirm Password" required>
                            </div>
                        </div>

                        <!-- Register Button -->
                        <button type="submit" class="btn btn-primary w-100 py-2">Register</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>