<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="menuPage" appConnect="local" components="{dmxNotifications:{}}" -->
<meta name="ac:route" content="/menu">

<div class="container mt-5">
    <h2 class="text-center mb-5">HR Portal Menu</h2>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">


        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <i class="fas fa-file-signature fa-3x text-primary mb-3"></i>
                    <h5 class="card-title mb-3">Recruitment</h5>
                    <button class="btn btn-outline-primary" dmx-on:click="">Submit Requisition Form</button>
                </div>
            </div>
        </div>

        <!-- Director Section -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <i class="fas fa-clipboard-check fa-3x text-primary mb-3"></i>
                    <h5 class="card-title mb-3">Director Dashboard</h5>
                    <button class="btn btn-outline-primary" dmx-on:click="navigateTo('director_dashboard')">Approve/Reject Requests</button>
                </div>
            </div>
        </div>

        <!-- HR Section -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <i class="fas fa-user-cog fa-3x text-primary mb-3"></i>
                    <h5 class="card-title mb-3">HR Management</h5>
                    <button class="btn btn-outline-primary mb-2" dmx-on:click="navigateTo('hr_edit')">Edit User Roles</button>
                    <button class="btn btn-outline-primary" dmx-on:click="navigateTo('hr_interview_time')">Update Interview Time</button>
                </div>
            </div>
        </div>

        <!-- AI Screening Section -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <i class="fas fa-robot fa-3x text-primary mb-3"></i>
                    <h5 class="card-title mb-3">AI Screening</h5>
                    <button class="btn btn-outline-primary" dmx-on:click="navigateTo('ai_screening')">Screen Candidates</button>
                </div>
            </div>
        </div>

        <!-- Candidate Section -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <i class="fas fa-upload fa-3x text-primary mb-3"></i>
                    <h5 class="card-title mb-3">Candidate</h5>
                    <button class="btn btn-outline-primary" dmx-on:click="navigateTo('upload_resume')">Upload Resume</button>
                </div>
            </div>
        </div>

        <!-- Business Unit Manager Section -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center"><i class="fas fa-tasks fa-3x text-primary mb-3"></i>
                    <h5 class="card-title mb-3">Business Unit</h5>
                    <button class="btn btn-outline-primary" dmx-on:click="navigateTo('bu_dashboard')">View &amp; Update Scoring</button>
                </div>
            </div>
        </div>

    </div>
</div>