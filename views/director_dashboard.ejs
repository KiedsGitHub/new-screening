<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="director_dashboard" appConnect="local" -->
<dmx-serverconnect id="displayRequest" url="/api/action/displayRequest"></dmx-serverconnect>
<meta name="ac:route" content="/director_dashboard">

<div class="container my-4">
    <h2 class="text-center">Director Dashboard</h2>
    <p class="text-center">Approve or Reject Requests from Business Units</p>

    <!-- Approval Requests Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5>Approval Requests</h5>
        </div>
        <div class="card-body">
            <table class="table table-hover" id="tableForm">
                <thead>
                    <tr>
                        <th>Request ID</th>
                        <th>Job Title</th>
                        <th>Submitted By</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody is="dmx-repeat" dmx-bind:repeat="displayRequest.data.query">
                    <tr>
                        <td>{{request_id}}</td>
                        <td>{{job_title}}</td>
                        <td>{{requester_name}}</td>
                        <td>
                            <span class="badge" dmx-bind:class="status == 'Pending' ? 'bg-warning text-dark' : (status == 'Approved' ? 'bg-success' : 'bg-danger')">
                                {{status}}
                            </span>
                        </td>
                        <td>
                            <!-- Approve Button -->
                            <button class="btn btn-success btn-sm" dmx-on:click="approveRequest(request_id).then(displayRequest.load())">Approve</button>
                            <!-- Reject Button -->
                            <button class="btn btn-danger btn-sm" dmx-on:click="rejectRequest(request_id).then(displayRequest.load())">Reject</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>