<!-- Wappler include head-page="layouts/main" fontawesome_5="cdn" bootstrap5="local" is="dmx-app" id="director_dashboard" appConnect="local" components="{dmxBootstrap5Alert:{}}" -->
<dmx-serverconnect id="displayRequest" url="/api/action/displayRequest"></dmx-serverconnect>
<dmx-serverconnect id="approveRequest" url="/api/action/approveRequest"></dmx-serverconnect>
<dmx-serverconnect id="rejectRequest" url="/api/action/rejectRequest"></dmx-serverconnect>
<meta name="ac:route" content="/director_dashboard">

<div class="container my-4">
    <h2 class="text-center">Director Dashboard</h2>
    <p class="text-center">Approve or Reject Requests from Business Units</p>

    <!-- Alert Notifications -->
    <div id="notification" class="alert alert-dismissible fade show" role="alert" is="dmx-show" dmx-show="notificationMessage.value">
        <span dmx-bind:text="notificationMessage.value"></span>
        <button type="button" class="btn-close" dmx-on:click="notificationMessage.setValue('')" aria-label="Close"></button>
    </div>

    <!-- Approval Requests Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5>Approval Requests</h5>
        </div>
        <div class="card-body">
            <table class="table table-hover" id="tableForm">
                <thead>
                    <tr>
                        <th>Request ID</th>
                        <th>Job Title</th>
                        <th>Submitted By</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody is="dmx-repeat" dmx-bind:repeat="displayRequest.data.query">
                    <tr>
                        <td>{{request_id}}</td>
                        <td>{{job_title}}</td>
                        <td>{{requester_name}}</td>
                        <td>
                            <span class="badge" dmx-bind:class="status == 'Pending' ? 'bg-warning text-dark' : (status == 'Approved' ? 'bg-success' : 'bg-danger')">
                                {{status}}
                            </span>
                        </td>
                        <td>
                            <!-- Approve Button -->
                            <button class="btn btn-success btn-sm" dmx-on:click="approveRequest.load({request_id: request_id}).then(displayRequest.load()).then(notificationMessage.setValue('Request ID ' + request_id + ' Approved'))">Approve</button>
                            <!-- Reject Button -->
                            <button class="btn btn-danger btn-sm" dmx-on:click="rejectRequest.load({request_id: request_id}).then(displayRequest.load()).then(notificationMessage.setValue('Request ID ' + request_id + ' Rejected'))">Reject</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Hidden Variable for Notification Message -->
<dmx-value id="notificationMessage" value=""></dmx-value>